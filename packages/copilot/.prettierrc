{
  "printWidth": 120,
  "singleQuote": false,
  "plugins": ["@trivago/prettier-plugin-sort-imports", "prettier-plugin-jsdoc"],
  "importOrder": ["<BUILTIN_MODULES>", "^react", "^@raycast/(.*)$", "<THIRD_PARTY_MODULES>", "^[.]"],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
